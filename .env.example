# Copy to .env and fill in. Never commit .env.

# Anthropic API key, from https://platform.claude.com (API keys).
ANTHROPIC_API_KEY=

# Optional: the Claude model the agents use. Defaults to claude-sonnet-5-5.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: usage limits for a public deployment (0 turns a limit off).
# SESSION_BRIEF_LIMIT=2
# DAILY_BRIEF_LIMIT=10
